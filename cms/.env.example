# ==========================================
# OMR Website CMS Environment Variables
# ==========================================

# GitHub API Personal Access Token (PAT with 'repo' permissions)
VITE_GITHUB_TOKEN=ghp_your_personal_access_token_here

# GitHub Repository Owner / Username / Organization
VITE_GITHUB_OWNER=your-github-username-or-org

# GitHub Repository Name
VITE_GITHUB_REPO=omr_website_v1

# Target Git Branch for Production Commits
VITE_GITHUB_BRANCH=new_main

# Live Website Preview Target URL
VITE_WEBSITE_URL=http://localhost:3001
