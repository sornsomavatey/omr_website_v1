[Unit]
Description=One More Restaurant frontend
After=network.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/omr_website_phase1/Frontend
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=TRUST_PROXY=true
EnvironmentFile=-/var/www/omr_website_phase1/Frontend/.env
ExecStart=/usr/bin/npm run dev
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
