[Unit]
Description=One More Restaurant FastAPI backend
After=network.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/omr_website_phase1/backend
EnvironmentFile=-/var/www/omr_website_phase1/backend/.env
ExecStart=/var/www/omr_website_phase1/backend/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
