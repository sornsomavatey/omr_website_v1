APP_NAME=One More Restaurant Backend
APP_VERSION=0.1.0
API_PREFIX=/api
GOOGLE_ANALYTICS_ID=UA-XXXXXXX-X
FACEBOOK_ANALYTICS_TOKEN=your_facebook_token_here
CUSTOM_ANALYTICS_ENABLED=true
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
EXPRESS_PORT=3002

# Telegram Bot Alert Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Alert SMTP Settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=user@example.com
SMTP_PASSWORD=your_smtp_password_here
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_TO_EMAIL=admin@example.com

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RESERVATION_RATE_LIMIT_REQUESTS=3
RESERVATION_RATE_LIMIT_WINDOW_SECONDS=600
CONTACT_RATE_LIMIT_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
ORDER_RATE_LIMIT_REQUESTS=10
ORDER_RATE_LIMIT_WINDOW_SECONDS=600
PAYMENT_RATE_LIMIT_REQUESTS=5
PAYMENT_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
PASSWORD_RESET_RATE_LIMIT_REQUESTS=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
NEWSLETTER_RATE_LIMIT_REQUESTS=3
NEWSLETTER_RATE_LIMIT_WINDOW_SECONDS=3600
ADMIN_API_KEY=replace-with-a-long-random-secret
