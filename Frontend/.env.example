

# 1. Telegram Bot Alert Settings (Staff Push Notifications)
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id_here
VITE_TELEGRAM_RESERVATION_THREAD_ID=2
VITE_TELEGRAM_FEEDBACK_THREAD_ID=4

# 2. Web3Forms Access Key (Email Notifications - web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# 3. Security & Production Settings
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_REQUESTS=120

# 4. API & Asset Base URLs
VITE_API_URL=http://localhost:8000/api
VITE_WEBAPP_IMAGE_URL=https://omd.a2hosted.com
