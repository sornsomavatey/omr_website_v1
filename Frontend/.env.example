# Server-side Telegram Bot Configuration (Hidden from client DevTools)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_RESERVATION_THREAD_ID=2
TELEGRAM_FEEDBACK_THREAD_ID=4
TELEGRAM_EVENT_THREAD_ID=2

# Server-side Mail SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
TEAM_ALERT_EMAIL=your_team_alert_email@gmail.com

# API & Base URLs
VITE_WEBAPP_IMAGE_URL=https://omd.a2hosted.com
